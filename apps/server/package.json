{
  "name": "@sicht/server",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "models:download": "tsx src/scripts/downloadModels.ts",
    "selftest": "tsx src/scripts/selftest.ts",
    "test": "tsx --test test/*.test.ts",
    "exercise:fetch": "tsx src/scripts/fetchFootage.ts",
    "exercise:evaluate": "tsx src/scripts/runExercise.ts",
    "map:extract": "tsx src/scripts/map/extractTiles.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.11",
    "@huggingface/transformers": "^4.3.2",
    "fastify": "^5.12.8",
    "onnxruntime-node": "1.30.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
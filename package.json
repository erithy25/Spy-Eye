{
  "name": "sicht",
  "private": true,
  "version": "0.5.0",
  "description": "Sicht: the civil operating picture. Sovereign visual intelligence for civil protection, running entirely on local infrastructure.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @sicht/server start",
    "typecheck": "pnpm -r typecheck",
    "models:download": "pnpm --filter @sicht/server models:download",
    "selftest": "pnpm --filter @sicht/server selftest",
    "test": "pnpm --filter @sicht/server test",
    "exercise:fetch": "pnpm --filter @sicht/server exercise:fetch",
    "exercise:evaluate": "pnpm --filter @sicht/server exercise:evaluate",
    "search:evaluate": "pnpm --filter @sicht/server search:evaluate",
    "demo": "node apps/server/dist/index.js --nodes nodes.demo.json",
    "demo:prepare": "node apps/server/dist/index.js --nodes nodes.demo.json --prepare",
    "demo:check": "node apps/server/dist/scripts/checkDemo.js"
  }
}
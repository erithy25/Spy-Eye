# Alle Werte sind optional; hier stehen die Defaults.

# Server
HOST=127.0.0.1
PORT=8787
DATA_DIR=data
MODEL_CACHE_DIR=.models
MAX_UPLOAD_GB=20

# Modell (ONNX-Export eines MobileCLIP-, SigLIP- oder CLIP-Dual-Encoders)
#   Xenova/mobileclip_s2             Default: gleiche Trefferqualität wie SigLIP im Test, gut 2x schneller
#   Xenova/mobileclip_s0             nochmals knapp 2x schneller, bei schwierigen Queries etwas schwächer
#   Xenova/siglip-base-patch16-224   größtes Modell, am langsamsten
MODEL_ID=Xenova/mobileclip_s2
MODEL_DTYPE=fp32
# Ausführung: cpu | auto (Windows: DirectML, Linux: CUDA, sonst CPU) | dml | cuda
ML_DEVICE=cpu
# ML_THREADS=8
ML_BATCH_SIZE=8

# 1 = keinerlei Netzwerkzugriff; das Modell muss bereits im Cache liegen (pnpm models:download)
SPY_EYE_OFFLINE=0

# Pfad zu ffmpeg, falls nicht im PATH
FFMPEG_PATH=ffmpeg
# Breite der extrahierten Analyse-Frames in Pixeln
FRAME_WIDTH=640

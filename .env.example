# Alle Werte sind optional; hier stehen die Defaults.

# Server
HOST=127.0.0.1
PORT=8787
DATA_DIR=data
MODEL_CACHE_DIR=.models
MAX_UPLOAD_GB=20

# Modell (ONNX-Export eines SigLIP- oder CLIP-Dual-Encoders)
#   Xenova/siglip-base-patch16-224   Default, beste Qualität (~120 ms pro Bildausschnitt auf 4 CPU-Kernen)
#   Xenova/clip-vit-base-patch32     ca. 4x schneller, sichtbar ungenauer
MODEL_ID=Xenova/siglip-base-patch16-224
MODEL_DTYPE=fp32
# ML_THREADS=8
ML_BATCH_SIZE=8

# 1 = keinerlei Netzwerkzugriff; das Modell muss bereits im Cache liegen (pnpm models:download)
SPY_EYE_OFFLINE=0

# Pfad zu ffmpeg, falls nicht im PATH
FFMPEG_PATH=ffmpeg
# Breite der extrahierten Analyse-Frames in Pixeln
FRAME_WIDTH=640
